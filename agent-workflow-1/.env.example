SERVER_PORT=8080
AGENT_MAX_STEPS=8
AGENT_DEADLINE_SECONDS=30
AGENT_PERSISTENCE=memory
# Optional PostgreSQL repository configuration.
POSTGRES_URL=jdbc:postgresql://localhost:5432/workflow_agent
POSTGRES_USER=workflow
POSTGRES_PASSWORD=change-me
# Optional DeepSeek planner. Keep false for offline tests.
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=30
# Audit outbox publisher is disabled until a real sink (Kafka/SIEM/etc.) is configured.
AUDIT_OUTBOX_PUBLISHER_ENABLED=false
AUDIT_OUTBOX_FIXED_DELAY_MS=5000
AUDIT_OUTBOX_BATCH_SIZE=50
AUDIT_OUTBOX_LEASE_SECONDS=30
AUDIT_OUTBOX_RETRY_DELAY_SECONDS=10
