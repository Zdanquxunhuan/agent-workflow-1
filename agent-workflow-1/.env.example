SERVER_PORT=8080
CONVERSATION_CONTEXT_BUDGET=6000
CONVERSATION_RETENTION_DAYS=7
# Production deployments activate the prod profile and its fail-closed configuration guard.
# It rejects memory persistence, local auth, dev tokens, demo seeding and default DB passwords.
SPRING_PROFILES_ACTIVE=
AGENT_MAX_STEPS=8
AGENT_DEADLINE_SECONDS=30
AGENT_PERSISTENCE=memory
# Startup recovery marks CREATED/PLANNING/RUNNING tasks older than this threshold as RECOVERY_REQUIRED.
AGENT_RECOVERY_STALE_SECONDS=120
# MySQL business/task store. Used when AGENT_PERSISTENCE=jdbc.
MYSQL_URL=jdbc:mysql://localhost:3307/workflow_agent?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_USER=workflow
MYSQL_PASSWORD=workflow_dev_only
MYSQL_POOL_MAX_SIZE=10
MYSQL_POOL_MIN_IDLE=2
# Authentication. local = HS256 verification for offline demo/tests; oidc = issuer discovery or JWK Set.
# Production must set AGENT_PERSISTENCE=jdbc, use oidc, and never enable the dev token endpoint.
AGENT_AUTH_MODE=local
AGENT_AUTH_ISSUER=
AGENT_AUTH_AUDIENCE=
AGENT_AUTH_OIDC_ISSUER_URI=
AGENT_AUTH_JWK_SET_URI=
AGENT_AUTH_LOCAL_SECRET=local-dev-only-change-me-32-bytes-minimum
# Dot path is supported, e.g. realm_access.roles for Keycloak.
AGENT_AUTH_ROLES_CLAIM=roles
AGENT_AUTH_DEV_TOKEN_ENABLED=false
AGENT_AUTH_DEV_TOKEN_TTL_SECONDS=3600
# Seed ORD-1001..ORD-1010 demo data. Local/demo only, never in production.
COMMERCE_SEED_DEMO_DATA=false
# Independent local business service (compose.business.yaml). HTTP mode requires JDBC.
COMMERCE_GATEWAY=sandbox
COMMERCE_HTTP_BASE_URL=http://localhost:8091
COMMERCE_HTTP_API_KEY=
COMMERCE_HTTP_TIMEOUT_SECONDS=2
COMMERCE_HTTP_WRITES_ENABLED=false
COMMERCE_DISPATCHER_ENABLED=true
COMMERCE_DISPATCHER_FIXED_DELAY_MS=3000
COMMERCE_DISPATCHER_BATCH_SIZE=20
COMMERCE_DISPATCHER_LEASE_SECONDS=30
COMMERCE_DISPATCHER_RETRY_DELAY_SECONDS=10
COMMERCE_DISPATCHER_MAX_ATTEMPTS=5
# Optional DeepSeek planner. Keep false for offline tests.
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=30
# V5: explicit gateway and tenant allowlist; no automatic fallback.
DEEPSEEK_GATEWAY=legacy
DEEPSEEK_MAX_OUTPUT_TOKENS=1200
DEEPSEEK_ALLOWED_TENANTS=
# Existing commerce adapters serve exactly one tenant.
COMMERCE_TENANT=legacy
AGENT_KNOWLEDGE_BACKEND=local
RAG_HTTP_BASE_URL=
RAG_HTTP_AUDIENCE=rag-api
RAG_HTTP_TIMEOUT_SECONDS=15
RAG_TASK_ENABLED=false
# Local development delegation only; must match the local RAG verifier.
RAG_DELEGATION_LOCAL_SECRET=
RAG_DELEGATION_ISSUER=rag-local
# Audit outbox publisher is disabled until a real sink (Kafka/SIEM/etc.) is configured.
AUDIT_OUTBOX_PUBLISHER_ENABLED=false
AUDIT_OUTBOX_FIXED_DELAY_MS=5000
AUDIT_OUTBOX_BATCH_SIZE=50
AUDIT_OUTBOX_LEASE_SECONDS=30
AUDIT_OUTBOX_RETRY_DELAY_SECONDS=10
