SHIPMENT_ENVIRONMENT=production
SHIPMENT_RESOURCE_URL=https://shipment.example.internal/mcp
SHIPMENT_ISSUER=https://identity.example.internal/
SHIPMENT_JWKS_URL=https://identity.example.internal/.well-known/jwks.json
SHIPMENT_ALLOWED_CLIENT=workflow-agent
SHIPMENT_AUTH_MODE=oidc
# Local mode only; never use the local issuer in production.
SHIPMENT_LOCAL_SECRET=
SHIPMENT_TENANT=demo
SHIPMENT_DB_HOST=mysql.example.internal
SHIPMENT_DB_PORT=3306
SHIPMENT_DB_NAME=workflow_agent
SHIPMENT_DB_USER=mcp_reader
SHIPMENT_DB_PASSWORD=
SHIPMENT_DB_CA=/run/secrets/mysql-ca.pem
SHIPMENT_ALLOWED_HOSTS=shipment.example.internal
SHIPMENT_ALLOWED_ORIGINS=https://shipment.example.internal
