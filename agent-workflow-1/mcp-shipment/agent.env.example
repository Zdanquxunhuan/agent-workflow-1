# Merge these keys into the Java deployment's secret/config system. Do not source into a live deployment unreviewed.
MCP_SHIPMENT_ENABLED=true
MCP_SHIPMENT_URL=https://shipment.example.internal/mcp
MCP_SHIPMENT_ALLOW_LOCAL_HTTP=false
# RFC 8693 confidential client: the authorization server must preserve subject and tenant_id.
# Leave the exchange fields empty only if the incoming, verified JWT already targets MCP_SHIPMENT_URL.
MCP_SHIPMENT_TOKEN_URL=https://identity.example.internal/oauth/token
MCP_SHIPMENT_CLIENT_ID=workflow-agent
MCP_SHIPMENT_CLIENT_SECRET=
AGENT_PERSISTENCE=jdbc
COMMERCE_TENANT=demo
COMMERCE_GATEWAY=sandbox
# Despite the historical 'sandbox' gateway name, MCP reads actual JDBC ledger tables, never seeded fixtures.
COMMERCE_SEED_DEMO_DATA=false
MYSQL_POOL_MAX_SIZE=20
# Configure MYSQL_URL with sslMode=VERIFY_IDENTITY and the deployed Connector/J trust store.
# Existing prod-profile OIDC, model-provider allowlist and database secrets remain required.
