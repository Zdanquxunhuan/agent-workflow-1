# Copy to rag-service/.env (git-ignored). Never commit real keys.
# Compose: docker compose --env-file rag-service/.env -f compose.rag.yaml ...
DEEPSEEK_API_KEY=
RAG_ANSWER_ENABLED=false
# Explicitly authorizes these tenants' retrieved evidence to be sent to the configured model.
RAG_ANSWER_ALLOWED_TENANTS=["demo"]
RAG_ANSWER_PROVIDER=deepseek
RAG_ANSWER_BASE_URL=https://api.deepseek.com
RAG_ANSWER_MODEL=deepseek-flash
RAG_ANSWER_DEADLINE_SECONDS=40
RAG_ANSWER_MODEL_TIMEOUT=25
RAG_ANSWER_MAX_OUTPUT_TOKENS=1200
RAG_ANSWER_PROMPT_MAX_BYTES=24000
RAG_ANSWER_RESPONSE_MAX_BYTES=131072
RAG_ANSWER_REQUESTS_PER_MINUTE=30
RAG_ANSWER_TENANT_CONCURRENCY=2
