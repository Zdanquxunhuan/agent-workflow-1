# V9 opt-in template. Fill prices and budgets from your approved deployment policy; no live prices are assumed.
AGENT_RUNTIME_ENABLED=true
AGENT_PERSISTENCE=jdbc
DEEPSEEK_ENABLED=true
DEEPSEEK_GATEWAY=spring-ai
# Existing DEEPSEEK_BASE_URL / API_KEY / MODEL / ALLOWED_TENANTS remain required.
RUNTIME_CURRENCY=USD
RUNTIME_REQUEST_BUDGET=
RUNTIME_DAILY_BUDGET=
RUNTIME_PRIMARY_INPUT_PRICE=
RUNTIME_PRIMARY_OUTPUT_PRICE=
RUNTIME_PRIMARY_PRICE_VERSION=
RUNTIME_DEADLINE_SECONDS=60
RUNTIME_ATTEMPT_SECONDS=20
RUNTIME_MAX_ATTEMPTS=6
RUNTIME_MAX_TOOLS=8
RUNTIME_MAX_TOKENS=100000
RUNTIME_MAX_ACTIVE_PER_USER=2
RUNTIME_ALLOW_LOCAL_HTTP=false
RUNTIME_BACKUP_ENABLED=false
RUNTIME_BACKUP_BASE_URL=
RUNTIME_BACKUP_API_KEY=
RUNTIME_BACKUP_MODEL=
RUNTIME_BACKUP_ALLOWED_TENANTS=
RUNTIME_BACKUP_MAX_OUTPUT_TOKENS=1200
RUNTIME_BACKUP_INPUT_PRICE=
RUNTIME_BACKUP_OUTPUT_PRICE=
RUNTIME_BACKUP_PRICE_VERSION=
AGENT_RECOVERY_STALE_SECONDS=120
MYSQL_POOL_MAX_SIZE=20
# Production: SPRING_PROFILES_ACTIVE=prod, verified OIDC, MYSQL_URL sslMode=VERIFY_IDENTITY.
# Set credentials via secrets. Both model endpoints need tool-calling + JSON response compatibility.
# Prices: currency units per 1,000,000 tokens. Budgets: currency units, at most six decimal places.
