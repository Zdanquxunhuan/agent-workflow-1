# Local demonstration template, NOT production credentials/configuration.
# Copy to target/company-demo/demo.env. Do not commit keys or tokens.
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1
SPRING_PROFILES_ACTIVE=
AGENT_PERSISTENCE=jdbc
MYSQL_URL=jdbc:mysql://127.0.0.1:13371/workflow_agent?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_USER=workflow
MYSQL_PASSWORD=company_workflow_local_only
MYSQL_POOL_MAX_SIZE=20
MYSQL_POOL_MIN_IDLE=2
AGENT_AUTH_MODE=local
AGENT_AUTH_ISSUER=http://127.0.0.1:8080
AGENT_AUTH_AUDIENCE=workflow-agent
AGENT_AUTH_LOCAL_SECRET=rag-local-development-secret-at-least-32-bytes
AGENT_AUTH_DEV_TOKEN_ENABLED=false
COMMERCE_TENANT=demo
COMMERCE_GATEWAY=sandbox
COMMERCE_SEED_DEMO_DATA=true
COMMERCE_DISPATCHER_ENABLED=true
AGENT_KNOWLEDGE_BACKEND=http
RAG_HTTP_BASE_URL=http://127.0.0.1:8091
RAG_HTTP_AUDIENCE=rag-api
RAG_HTTP_TIMEOUT_SECONDS=15
RAG_TASK_ENABLED=true
RAG_DELEGATION_LOCAL_SECRET=rag-local-development-secret-at-least-32-bytes
RAG_DELEGATION_ISSUER=http://127.0.0.1:8080
RAG_RETRIEVAL_PROFILE=hybrid-rerank-v2
MEMORY_ENABLED=true
MEMORY_AUTO_EXTRACT=false
MEMORY_INDEX_URL=http://127.0.0.1:8091
MEMORY_INDEX_SECRET=company-memory-index-local-only-32-bytes
RAG_MEMORY_INDEX_ENABLED=true
RAG_MEMORY_INDEX_SECRET=company-memory-index-local-only-32-bytes
MCP_SHIPMENT_ENABLED=true
MCP_SHIPMENT_URL=http://127.0.0.1:8094/mcp
MCP_SHIPMENT_ALLOW_LOCAL_HTTP=true
MCP_SHIPMENT_TOKEN_URL=
MCP_SHIPMENT_CLIENT_ID=
MCP_SHIPMENT_CLIENT_SECRET=
# Phase A: ingestion/search/permissions, no generative model calls.
# Phase B: only after the executor obtains the model budget, fill and enable below.
DEEPSEEK_ENABLED=false
DEEPSEEK_GATEWAY=spring-ai
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_ALLOWED_TENANTS=demo
DEEPSEEK_MAX_OUTPUT_TOKENS=1200
RAG_ANSWER_ENABLED=false
RAG_ANSWER_ALLOWED_TENANTS=["demo"]
RAG_ANSWER_BASE_URL=https://api.deepseek.com
RAG_ANSWER_MODEL=
RAG_ANSWER_MAX_OUTPUT_TOKENS=1200
AGENT_RUNTIME_ENABLED=false
AGENT_DIALOGUE_ENABLED=false
AGENT_DIALOGUE_MAX_REPLANS=2
AGENT_DIALOGUE_MAX_CLARIFICATIONS=3
AGENT_DIALOGUE_WAIT_SECONDS=900
AGENT_DIALOGUE_LIFETIME_SECONDS=1800
RUNTIME_CURRENCY=USD
RUNTIME_REQUEST_BUDGET=
RUNTIME_DAILY_BUDGET=
RUNTIME_PRIMARY_INPUT_PRICE=
RUNTIME_PRIMARY_OUTPUT_PRICE=
RUNTIME_PRIMARY_PRICE_VERSION=
RUNTIME_DEADLINE_SECONDS=60
RUNTIME_ATTEMPT_SECONDS=20
RUNTIME_MAX_ATTEMPTS=6
RUNTIME_MAX_TOOLS=8
RUNTIME_MAX_TOKENS=100000
RUNTIME_MAX_ACTIVE_PER_USER=2
RUNTIME_ALLOW_LOCAL_HTTP=false
RUNTIME_BACKUP_ENABLED=false
