# V10 opt-in. Also supply deploy/runtime.env.example and existing OIDC/RAG/MCP configuration.
# These are limits for a whole clarification chain, not a new allowance on every input.
AGENT_DIALOGUE_ENABLED=true
AGENT_DIALOGUE_MAX_REPLANS=2
AGENT_DIALOGUE_MAX_CLARIFICATIONS=3
AGENT_DIALOGUE_WAIT_SECONDS=900
AGENT_DIALOGUE_LIFETIME_SECONDS=1800
# V9 defaults remain: 60s total active execution, 6 model attempts, 8 tool calls,
# one provider fallback, configured token/cost budget, user/day budget.
# No model calls or worker slots are held while WAITING_INPUT.
